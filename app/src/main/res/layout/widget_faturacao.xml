<?xml version="1.0" encoding="utf-8"?>
<!-- Widget Faturação (17/10): vidro meio transparente, números grandes com sombra,
     anel da meta e barra do previsto desenhados em 3D. Nada se sobrepõe: tudo em colunas/linhas. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/w_fundo"
    android:orientation="vertical"
    android:paddingLeft="14dp"
    android:paddingRight="14dp"
    android:paddingTop="12dp"
    android:paddingBottom="10dp">

    <!-- cabeçalho -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="4dp"
            android:layout_height="16dp"
            android:background="@drawable/w_acento" />

        <TextView
            android:id="@+id/w_titulo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="8dp"
            android:letterSpacing="0.1"
            android:text="FATURAÇÃO"
            android:textColor="#22180F"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/w_hora"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="170dp"
            android:background="@drawable/w_chip"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingLeft="9dp"
            android:paddingRight="9dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:text="…"
            android:textColor="#4A4038"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/w_atualizar"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginLeft="8dp"
            android:background="@drawable/w_botao"
            android:gravity="center"
            android:shadowColor="#66000000"
            android:shadowDy="2"
            android:shadowRadius="3"
            android:text="↻"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- empresa -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hoje"
                android:textColor="#5E5248"
                android:textSize="11sp" />
            <TextView
                android:id="@+id/w_dia_val"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:shadowColor="#55000000"
                android:shadowDx="0"
                android:shadowDy="3"
                android:shadowRadius="4"
                android:text="—"
                android:textColor="#C8102E"
                android:textSize="23sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Este mês"
                android:textColor="#5E5248"
                android:textSize="11sp" />
            <TextView
                android:id="@+id/w_mes_val"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:shadowColor="#55000000"
                android:shadowDx="0"
                android:shadowDy="3"
                android:shadowRadius="4"
                android:text="—"
                android:textColor="#22180F"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/w_linha" />

    <!-- Pedro: anel da meta + texto ao lado -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/w_anel"
            android:layout_width="78dp"
            android:layout_height="78dp"
            android:scaleType="fitCenter" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="12dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:shadowColor="#33000000"
                android:shadowDy="2"
                android:shadowRadius="2"
                android:text="Pedro Melo"
                android:textColor="#22180F"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/w_ped_linha"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text=""
                android:textColor="#4A4038"
                android:textSize="11.5sp" />

            <TextView
                android:id="@+id/w_estado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:background="@drawable/w_chip_vermelho"
                android:maxLines="1"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:shadowColor="#66000000"
                android:shadowDy="1"
                android:shadowRadius="2"
                android:text=""
                android:textColor="#FFFFFF"
                android:textSize="11.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/w_ritmo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:maxLines="2"
                android:text=""
                android:textColor="#4A4038"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- barra da meta com a marca do previsto (o texto "previsto hoje" vem dentro da imagem, por cima da barra) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:shadowColor="#33000000"
            android:shadowDy="2"
            android:shadowRadius="2"
            android:text="O meu objetivo"
            android:textColor="#22180F"
            android:textSize="13sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/w_obj_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text=""
            android:textColor="#4A4038"
            android:textSize="11sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/w_grafico"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="2dp"
        android:scaleType="fitCenter" />

    <!-- barra do mês da empresa: faturado vs meta (ou dias do mês, se não houver meta) -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/w_linha" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:shadowColor="#33000000"
            android:shadowDy="2"
            android:shadowRadius="2"
            android:text="Mês da empresa"
            android:textColor="#22180F"
            android:textSize="13sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/w_mes_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text=""
            android:textColor="#4A4038"
            android:textSize="11sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/w_grafico_mes"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="2dp"
        android:scaleType="fitCenter" />
</LinearLayout>
