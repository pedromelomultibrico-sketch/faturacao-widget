<?xml version="1.0" encoding="utf-8"?>
<!-- TABLET: o launcher MIUI não deixa esticar; o widget nasce já com a largura toda. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="900dp"
    android:minHeight="180dp"
    android:minResizeWidth="300dp"
    android:minResizeHeight="110dp"
    android:maxResizeWidth="3000dp"
    android:maxResizeHeight="2000dp"
    android:targetCellWidth="8"
    android:targetCellHeight="2"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/widget_faturacao"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen" />
